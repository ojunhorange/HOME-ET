# .env.local로 복사해서 채우기. 비어 있어도 앱은 동작함(가중치 1/3, 통학 수동 입력, 지도 자리표시).
GEMINI_API_KEY=            # Google AI Studio 키
GEMINI_MODEL=              # 비우면 gemini-flash-latest
GOOGLE_MAPS_SERVER_KEY=    # Routes API 사용 설정된 키 (서버 전용)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # Maps JavaScript API + Places API (New), 리퍼러 제한 걸기
